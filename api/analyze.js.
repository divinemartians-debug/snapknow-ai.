
export default async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");

  if (req.method !== "POST") {
    res.setHeader("Allow", "POST");
    return res.status(405).json({ error: "Use POST for this request." });
  }

  const apiKey = process.env.OPENROUTER_API_KEY;

  if (!apiKey) {
    return res.status(500).json({
      error: "AI setup is incomplete. Add the API key in Vercel settings."
    });
  }

  try {
    const { image, question } = req.body || {};

    if (
      typeof image !== "string" ||
      !/^data:image\/(jpeg|png|webp|gif);base64,/i.test(image)
    ) {
      return res.status(400).json({
        error: "Please upload a valid JPG, PNG, WEBP or GIF image."
      });
    }

    if (image.length > 11_500_000) {
      return res.status(413).json({
        error: "Image is too large. Please choose a smaller photo."
      });
    }

    if (
      typeof question !== "string" ||
      !question.trim() ||
      question.length > 1000
    ) {
      return res.status(400).json({
        error: "Enter a question of up to 1,000 characters."
      });
    }

    const aiResponse = await fetch(
      "https://openrouter.ai/api/v1/chat/completions",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${apiKey}`,
          "Content-Type": "application/json",
          "X-Title": "SnapKnow AI"
        },
        body: JSON.stringify({
          model: "openrouter/free",
          messages: [
            {
              role: "user",
              content: [
                {
                  type: "text",
                  text:
                    "You are SnapKnow AI, a helpful visual learning assistant. " +
                    "Answer using the supplied image and the user's question. " +
                    "Be clear, friendly and informative. Separate visible facts " +
                    "from guesses. Admit uncertainty and never invent details. " +
                    "Question: " + question.trim()
                },
                {
                  type: "image_url",
                  image_url: { url: image }
                }
              ]
            }
          ]
        })
      }
    );

    const data = await aiResponse.json();

    if (!aiResponse.ok) {
      console.error("AI provider error:", aiResponse.status);
      return res.status(502).json({
        error: "The AI service is busy or unavailable. Try again shortly."
      });
    }

    const answer = data.choices?.[0]?.message?.content;

    if (typeof answer !== "string" || !answer.trim()) {
      return res.status(502).json({
        error: "The AI returned no answer. Please try again."
      });
    }

    return res.status(200).json({ answer: answer.trim() });
  } catch (error) {
    console.error("SnapKnow request failed:", error.message);
    return res.status(500).json({
      error: "Something went wrong. Please try again."
    });
  }
}
